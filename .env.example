# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
OPENROUTER_API_KEY=

# Microsoft Entra ID (MSAL) - Variables públicas de frontend (no secretos)
# VITE_ENTRA_CLIENT_ID: Identificador de la aplicación (Application / Client ID) desde Entra Admin Center
VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_TENANT_ID: Identificador de Directorio / Inquilino (Directory / Tenant ID) o 'organizations' / 'common'
VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_REDIRECT_URI: URI de redirección registrada como SPA en Microsoft Entra ID (ej: http://localhost:3000 o dominio Vercel)
VITE_ENTRA_REDIRECT_URI=
