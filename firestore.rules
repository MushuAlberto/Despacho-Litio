rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create, update: if isValidId(userId)
        && incoming().userId is string && incoming().userId.size() <= 128
        && incoming().username is string && incoming().username.size() <= 128
        && incoming().name is string && incoming().name.size() <= 128
        && incoming().role is string && incoming().role.size() <= 128;
      allow delete: if isValidId(userId);
    }

    // 3. Activity Logs Collection
    match /activity_logs/{logId} {
      allow get: if isValidId(logId);
      allow list: if true;
      allow create: if isValidId(logId) 
        && incoming().userId is string && incoming().userId.size() <= 128
        && incoming().username is string && incoming().username.size() <= 128
        && incoming().name is string && incoming().name.size() <= 128
        && incoming().role is string && incoming().role.size() <= 128
        && incoming().action is string && incoming().action.size() <= 256
        && incoming().timestamp is string && incoming().timestamp.size() <= 64;
      allow update, delete: if isValidId(logId);
    }
  }
}
